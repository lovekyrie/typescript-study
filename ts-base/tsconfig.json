{
  "compilerOptions": {
    /* 基础：Webpack 打包 + 现代 ES */
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020", "DOM"],
    "moduleResolution": "bundler",
    "rootDir": "./src",
    "outDir": "./lib",
    "noEmit": true,

    /* 严格模式（学习项目保留 noImplicitAny: false，便于演示隐式 any） */
    "strict": true,
    "noImplicitAny": false,
    "strictNullChecks": true,

    /* 模块互操作 */
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    /* 与独立文件编译兼容 */
    "isolatedModules": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["src/"],
  "exclude": [
    "src/tpl",
    "src/part2.project/05.tsconfig/**",
    "src/part2.project/06.tsconfig/**",
    "src/part2.project/07.project-reference/**"
  ]
}
